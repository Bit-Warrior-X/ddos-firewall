
[Unit]
Description=eBPF XDP Anti-DDoS Firewall
After=network-online.target
Wants=network-online.target


[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/usr/local/share/ebpf_firewall/
# Optional: mlx5/bond IRQ+RPS spread (stops irqbalance). Omit --skip-iptables if you do not want iptables touched.
#ExecStartPre=/usr/local/share/ebpf_firewall/ddos-firewall-system-setup.sh bond0 --skip-iptables --spread-nic-processing --high-pps-softnet
ExecStart=/usr/local/share/ebpf_firewall/ebpf_firewall_userspace
Restart=on-failure
RestartSec=1

Environment="LD_LIBRARY_PATH=/usr/local/lib"
Environment="EBPF_FIREWALL_XDP_KO=/usr/local/share/ebpf_firewall/ebpf_firewall_kernel.o"
Environment="EBPF_FIREWALL_XDP_CONFIG=/usr/local/share/ebpf_firewall/firewall.config"
Environment="PUBKEY_PATH=/usr/local/share/ebpf_firewall/server_public_key.pem"
Environment="LICENSE_PATH=/usr/local/share/ebpf_firewall/license.lic"


# --- Memory ---
# BPF maps need locked memory. Without this, map creation fails.
LimitMEMLOCK=infinity

# --- File descriptors ---
# BPF maps, ring buffers, conntrack sockets all consume FDs.
LimitNOFILE=1048576

# --- Scheduling priority ---
# Do NOT use Nice=-20: it starves sshd, nginx, and other services during a flood,
# so you cannot connect to administer the host. Default (0) keeps admin traffic viable.
Nice=0

# --- Core dumps ---
# Enable core dumps for debugging crash-during-attack issues.
# Disable again once the bug is found.
LimitCORE=infinity

# --- Process isolation ---
# The firewall needs full network access but nothing else.
#ProtectSystem=strict
#ReadWritePaths=/var /tmp /usr/local/share/ebpf_firewall
#ProtectHome=yes
#PrivateTmp=yes
#NoNewPrivileges=no

# --- Restart behavior ---
# If the firewall crashes during an attack, restart immediately.
# The conntrack flush + iptables DROP NEW rule protects during the gap.
#
# Do NOT set WatchdogSec until the daemon calls sd_notify(0, "WATCHDOG=1") on a
# timer (e.g. every WatchdogSec/2). Without it, systemd kills the process on each
# timeout and you get repeated core dumps in /var/crash (often exactly
# StartLimitBurst times per StartLimitIntervalSec).
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
