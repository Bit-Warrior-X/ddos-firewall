#==============================================================================
#  Sparta firewall.config  —  adaptive L4  (prefer_adaptive = 1)
#------------------------------------------------------------------------------
#  Detection  : shadow EWMA / CUSUM (not classic host-wide *_threshold)
#  Mitigation : per-source fixed/burst, SYN cookies, stepped mit_mode caps
#  Reference  : plan/firewall.redesign.config
#  Sysctl     : net.netfilter.nf_conntrack_tcp_loose = 0
#==============================================================================


#------------------------------------------------------------------------------
#  1. Global
#------------------------------------------------------------------------------
#  Logs live under the Sparta install tree (not /var/log):
#    log            → dir; writes hourly  logs/sparta-YYYYMMDD-HH.log
#                     plus symlink         logs/latest.log
#    attack_log_dir → one archive file per attack episode (off/none to disable)

log                        = /usr/local/share/dorian/sparta/logs
attack_log_dir             = /usr/local/share/dorian/sparta/logs/attacks
dev                        = bond0                 # NIC/bond for XDP attach
attach_mode                = native                # native | generic
ipv6                       = 1                     # 1=IPv6 path on, 0=IPv4 focus
block_initial_seconds      = 60                    # first proven-source block TTL
block_max_seconds          = 3600                  # max TTL after offence doubling

#  BPF map sizing — applied at load from this host's RAM / CPU count.
#  Per-source & per-connection maps scale from compiled defaults:
#    small x1/4 | medium x1/2 | standard x1 | large x2 | xlarge x4
#  auto = largest profile whose preallocated maps fit the RAM budget.
#  Preview without loading:  sparta_user --map-plan
map_size_profile           = auto                  # auto | small | medium | standard | large | xlarge
map_memory_budget_percent  = 8                     # auto: max % of RAM for maps


#------------------------------------------------------------------------------
#  2. Adaptive control
#------------------------------------------------------------------------------

prefer_adaptive            = 1                     # 1=shadow owns Attack START
enforce_drop_invalid       = 1                     # 1=drop invalid when mode>=1


#------------------------------------------------------------------------------
#  3. Service profile  (validity allowlists)
#------------------------------------------------------------------------------

service_http3              = 1                     # UDP/TCP 443 + QUIC allowed
service_dns                = 0                     # 1=allow DNS 53
service_gre_tunnels        = 0                     # 0=any GRE is hostile
quic_header_check          = 1                     # QUIC Initial / long-header
icmp_drop_fragments        = 1                     # drop fragmented ICMP
synack_match_outbound      = 1                     # TC egress SYN match (H7)


#------------------------------------------------------------------------------
#  4. Shadow detection  —  Layer 1 (NIC / softirq)
#------------------------------------------------------------------------------

nic_drop_trigger_seconds   = 3                     # sustained NIC drop → DST_CAP
softirq_trigger_percent    = 80                    # softirq CPU % threshold
softirq_trigger_seconds    = 3                     # hold time before trigger


#------------------------------------------------------------------------------
#  5. Shadow detection  —  Layer 2 (baseline)
#------------------------------------------------------------------------------
#  Enter gate = max(mean + k*sigma, m*mean), then clamped to floor / capacity.
#
#  detection_level (proficiency 1..10) scales floors + baseline + confirm:
#    1=minimal … 5=normal … 8=high … 10=max
#    Names: minimal|very_low|low|moderate_low|normal|
#           moderate_high|elevated|high|very_high|max

detection_level            = 5                     # normal — fewer false L7 alerts
baseline_k                 = 6                     # sigma multiplier (level-5 ref)
baseline_m                 = 3                     # mean multiplier (level-5 ref)
baseline_seasonal          = hour_of_week          # hour_of_week | off
learning_days              = 0                     # 0=60s warm-up; 7=days (cap/4 ceiling)
cusum                      = 1                     # 1=CUSUM force-enter


#------------------------------------------------------------------------------
#  6. Shadow detection  —  Layer 3 / 4 + lifecycle
#------------------------------------------------------------------------------

invalid_floor_pps          = 1000                  # min invalid pps for L3
invalid_ratio              = 0.05                  # invalid/total → force Attack
flow_pps_k                 = 6                     # per-flow DATA vs mean
src_bucket_k               = 3                     # per-source bucket vs mean
confirm_windows            = 3                     # 1s windows to enter Attack
exit_windows               = 45                    # soft below-exit hold before Cooldown
quiet_clear_windows        = 10                    # idle (rate≪exit) → leave Attack in N s
alert_hold_windows         = 5                     # defer panel/episode until Attack lasts N s
cooldown_seconds           = 90                    # Cooldown before Normal (mitigation only)
escalate_after_windows     = 5                     # +1 mit_mode while Attack
surge_factor               = 3                     # rate ≥ enter×N → Attack+DST_CAP at once (0=off)
rearm_seconds              = 300                   # re-entry within N s → no confirm/hold, restore peak mode


#------------------------------------------------------------------------------
#  7. Per-source limits while Attack
#------------------------------------------------------------------------------
#  *_valid                 enable class handlers / maps
#  *_burst_pkt             packets in one micro-burst
#  *_burst_count_per_sec   micro-bursts/sec → burst block
#  *_fixed_threshold       packet count in window → fixed block
#  *_fixed_check_duration  window length (seconds)

# --- SYN ---
syn_valid                  = 1
syn_burst_pkt              = 50
syn_burst_count_per_sec    = 5
syn_fixed_threshold        = 300                   # CGNAT / proxy friendly
syn_fixed_check_duration   = 3
challenge_timeout          = 3                     # SYN-cookie window (s)

# --- ACK ---
ack_valid                  = 1
ack_burst_pkt              = 300
ack_burst_count_per_sec    = 50
ack_fixed_threshold        = 5000
ack_fixed_check_duration   = 15

# --- RST (spoofable — keep low) ---
rst_valid                  = 1
rst_burst_pkt              = 10
rst_burst_count_per_sec    = 5
rst_fixed_threshold        = 500
rst_fixed_check_duration   = 10

# --- ICMP (leave room for PMTU / monitoring) ---
icmp_valid                 = 1
icmp_burst_pkt             = 10
icmp_burst_count_per_sec   = 5
icmp_fixed_threshold       = 200
icmp_fixed_check_duration  = 10

# --- UDP (high when HTTP/3 on) ---
udp_valid                  = 1
udp_burst_pkt              = 50
udp_burst_count_per_sec    = 10
udp_fixed_threshold        = 30000
udp_fixed_check_duration   = 10

# --- GRE ---
gre_valid                  = 1
gre_burst_pkt              = 10
gre_burst_count_per_sec    = 5
gre_fixed_threshold        = 50
gre_fixed_check_duration   = 10

# --- DATA / STOMP (adaptive alerts use STOMP events) ---
stomp_valid                = 1
stomp_burst_pkt            = 50
stomp_burst_count_per_sec  = 10
stomp_fixed_threshold      = 5000
stomp_fixed_check_duration = 10

# --- HANDSHAKE (variable PSH / handshake path) ---
handshake_valid            = 1
handshake_burst_pkt        = 50
handshake_burst_count_per_sec = 10
handshake_fixed_threshold  = 5000
handshake_fixed_check_duration = 10

# --- SOCKET (odd flags / concurrent) ---
socket_valid               = 1
socket_fin_threshold       = 100                   # odd FIN rate per source
socket_fixed_threshold     = 500
socket_fixed_check_duration = 15


#------------------------------------------------------------------------------
#  8. Misc  (segment check, stats, geo, conntrack)
#------------------------------------------------------------------------------

tcp_seg_check              = 1                     # middle-fragment / seg abuse
stats_detail_sample_divisor = 1                    # 1=count every pkt for stats

geo_check                  = 0                     # 0=off 1=allow 2=block list
geo_db_ipv4_path           = geodb/ipv4.csv
geo_db_location_path       = geodb/location.csv
geo_countries              = NULL     # ISO codes for geo_check

tcp_connection_limit_check = 1                     # per-src conntrack cap
tcp_connection_limit_cnt   = 1000                  # max concurrent per source
