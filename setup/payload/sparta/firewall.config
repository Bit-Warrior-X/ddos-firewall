#------------------GLOBAL-------------------
log = /var/firewall.log
# Filled with this edge's main NIC at install (scripts/set-firewall-dev.sh).
dev = bond0
# drv mode gives best XDP performance on bonding driver with kernel 6.8+
# mode can be skb, native, drv, hw
attach_mode = native
# Block attacking IPs for 1 hour. Increase to 7200 (2h) if you get repeat offenders.
black_ip_duration = 3600

#------------------SYN-----------------------
syn_valid = 1
# THRESHOLD: Total SYN pps (across ALL source IPs) that triggers "attack mode".
# When global SYN rate exceeds this, per-IP burst + SYN challenge activate (on top of
# the fixed-window limit below). Below threshold, only fixed-window limiting runs for
# new sources — still blocks aggressive single-IP floods without extra RTT.
# Your server with 96 CPUs can handle ~50K legitimate SYN/s easily.
# Set to 100K to avoid false triggers from traffic spikes (CDN purge, flash crowd).
# A real SYN flood does 500K-10M+ pps, so 100K won't miss attacks.
syn_threshold = 100000

# BURST_PKT: How many SYNs from ONE IP in a single burst triggers counting.
# A browser opening a page sends 6-20 parallel connections (HTTP/2 fallback, subresources).
# A CDN health check or load balancer can send 30-50 SYNs in a burst.
# Set to 50 to tolerate aggressive but legitimate clients.
syn_burst_pkt = 50

# BURST_COUNT_PER_SEC: How many bursts per second from ONE IP triggers block.
# If one IP produces 5+ bursts of 50+ SYNs within 1 second, it's attacking.
# Normal clients never produce more than 1-2 bursts per second.
syn_burst_count_per_sec = 5

# FIXED_THRESHOLD: Max SYNs from ONE IP within the fixed_check_duration window.
# This is the "slow and steady" attack detector.
# A legitimate client might open 200 connections in 10 seconds (aggressive crawler).
# 500 SYNs in 10 seconds from one IP = 50 SYN/s sustained — definitely an attack.
syn_fixed_threshold = 150

# FIXED_CHECK_DURATION: Window size in seconds for the fixed counter.
# 10 seconds is a good balance — short enough to catch attacks quickly,
# long enough to not trigger on brief legitimate bursts.
syn_fixed_check_duration = 3

# CHALLENGE_TIMEOUT: How long (seconds) a SYN challenge state lives.
# After this timeout, the challenge entry is cleaned up.
# 5 seconds accommodates high-latency clients (satellite, mobile).
challenge_timeout = 3

# PROTECTION_DURATION: How long (seconds) attack mode stays active after
# the global pps drops below threshold. Prevents rapid on/off oscillation.
# 120 seconds means the system stays in protection mode for 2 minutes
# after the flood stops, catching any attacker retry.
syn_protection_duration = 120

#------------------ACK-----------------------
ack_valid = 1
# ACK floods tend to be higher volume than SYN because ACKs are smaller.
# Legitimate ACK traffic is much higher than SYN (every data exchange uses ACKs).
# Set threshold higher to avoid false triggers on busy servers.
ack_threshold = 300000

# ACK bursts are normal — TCP window updates, bulk transfers generate rapid ACKs.
# A single large file download can produce 100+ ACKs/s from one client.
# Set burst_pkt high to avoid blocking legitimate bulk transfers.
ack_burst_pkt = 300

# Legitimate clients rarely produce 50+ distinct bursts of 300+ ACKs per second.
ack_burst_count_per_sec = 50

# Per-IP fixed window: 5000 ACKs in 15 seconds = ~333 ACK/s sustained.
# A heavy download produces ~200 ACK/s. 333 has headroom.
# Note: established connections bypass this check via conntrack fast-path,
# so this only affects non-established (attack) ACKs.
ack_fixed_threshold = 5000
ack_fixed_check_duration = 15
ack_protection_duration = 120

#------------------RST-----------------------
rst_valid = 1
# RST floods are relatively rare. Legitimate RST traffic is very low
# (only happens on connection errors or port scans).
# Lower threshold detects attacks faster.
rst_threshold = 50000

# A single IP should almost never send more than a few RSTs per second.
# Port scanners send 1 RST per probed port, but legitimate clients send 0-2.
rst_burst_pkt = 10
rst_burst_count_per_sec = 5

# 100 RSTs from one IP in 10 seconds is definitely malicious.
rst_fixed_threshold = 100
rst_fixed_check_duration = 10
rst_protection_duration = 120

#------------------ICMP-----------------------
icmp_valid = 1
# ICMP floods (ping flood, smurf). Legitimate ICMP is very low volume.
# Monitoring systems send ~1 ping/s. 10K ICMP/s globally = definitely an attack.
icmp_threshold = 10000

# No legitimate source sends more than a few pings per second.
icmp_burst_pkt = 10
icmp_burst_count_per_sec = 5

# 50 ICMP from one IP in 10 seconds = 5/s. Aggressive but could be monitoring.
# 100 is safer to avoid blocking monitoring systems.
icmp_fixed_threshold = 100
icmp_fixed_check_duration = 10
icmp_protection_duration = 120

#------------------UDP------------------------
udp_valid = 1
# UDP floods are common (DNS amplification, NTP amplification, memcached).
# If your server runs UDP services (DNS, game server, VoIP), increase threshold.
# If only TCP services (web, SSH), legitimate UDP is very low.
udp_threshold = 100000

# UDP burst from one IP: DNS resolvers can send 50+ replies/s during a busy period.
# If you run a DNS server, set higher (200). For web-only servers, 50 is fine.
udp_burst_pkt = 50
udp_burst_count_per_sec = 10

# 500 UDP packets from one IP in 10 seconds. DNS amplification sends thousands.
udp_fixed_threshold = 500
udp_fixed_check_duration = 10
udp_protection_duration = 120

#------------------GRE------------------------
gre_valid = 1
# GRE is tunnel traffic. If you don't use GRE tunnels, any GRE traffic is suspicious.
# Very low threshold — even 1000 GRE/s globally is unusual unless you have tunnels.
gre_threshold = 5000

gre_burst_pkt = 10
gre_burst_count_per_sec = 5
gre_fixed_threshold = 50
gre_fixed_check_duration = 10
gre_protection_duration = 120
#----------------------------------------------

#-----------------TCP Segment check------------
# Enable fragment attack protection. Drops fragmented TCP packets
# (middle fragments without L4 headers). Legitimate TCP rarely fragments.
tcp_seg_check = 1

# Count every packet for stats. On 96 CPUs this has negligible overhead.
stats_detail_sample_divisor = 1
#----------------------------------------------

#-----------------Geo Location Check ----------
# 0: off, 1: allow (only listed countries pass), 2: block (listed countries dropped)
# Enable geo-blocking if you know your legitimate traffic sources.
# mode=2 blocks traffic from listed countries.
geo_check = 2
geo_db_ipv4_path = geodb/ipv4.csv
geo_db_location_path = geodb/location.csv
geo_countries = CN,RU,IN,PH,VN,BR
#----------------------------------------------

#-----------------TCP Connection Limit ---------
tcp_connection_limit_check = 1
# Max concurrent TCP connections per source IP.
# A browser opens 6-10 connections per domain. A CDN node or API gateway
# might open 100-200. Set to 200 to be safe.
# If you serve as a reverse proxy or CDN origin, increase to 500.
tcp_connection_limit_cnt = 200
#----------------------------------------------

#------------------STOMP------------------------
stomp_valid = 1
# Constant-length PSH+ACK from a source that did not complete a handshake.
# stomp_threshold is the PSH+ACK flag rate, in packets per second, that opens
# the flood. The STOMP and HANDSHAKE counters then pick which defense it is.
# A ~45k pps flood still dips under 50k, so 50000 misses it.
stomp_threshold = 10000
# Burst catches on/off spikes. A flat flood is blocked by the fixed window below.
# burst_count_per_sec must not be 0; the daemon refuses to start.
stomp_burst_pkt = 50
stomp_burst_count_per_sec = 10
# Per source, once protection is on: block after 200 packets in 10 seconds.
# The same pair is the gate for HANDSHAKE. Under it, packets stay on STOMP.
# A 45k pps source crosses 200 in a few milliseconds.
stomp_fixed_threshold = 200
stomp_fixed_check_duration = 10
stomp_protection_duration = 120
#----------------------------------------------

#------------------HandShake--------------------
handshake_valid = 1
# Variable-length PSH+ACK from one source, plus incoming SYN+ACK.
# For a PSH+ACK flood the gate is the lower of the two thresholds. This value
# also starts HANDSHAKE protection on its own when the HANDSHAKE counter
# (SYN+ACK, or scattered PSH+ACK) reaches it and PSH+ACK is still under the gate.
handshake_threshold = 10000
handshake_burst_pkt = 50
handshake_burst_count_per_sec = 10
handshake_fixed_threshold = 200
handshake_fixed_check_duration = 10
handshake_protection_duration = 120
#----------------------------------------------

#------------------SOCKET------------------------
# SOCKET is not a flood defense. No global threshold, no burst counter, no protection duration.
# SOCKET NULL scans and XMAS scans are dropped immediately.
# SOCKET FIN without acknowledgement, from a flow that is not established, blocks above fin_threshold.
# SOCKET every other unusual flag combination blocks above fixed_threshold in the same window.
socket_valid = 1
socket_fin_threshold = 100
socket_fixed_threshold = 500
socket_fixed_check_duration = 15
#----------------------------------------------

#-----------------Map Sizing--------------------
# Controls how many unique source IPs can be tracked simultaneously.
# Higher = more memory but better tracking during large attacks.
# Recommended: 65535 (small), 131072 (medium), 262144 (large), 524288 (enterprise)
#map_size_blocked_ips = 65535
#map_size_syn = 131072
#map_size_ack = 131072
#map_size_rst = 131072
#map_size_icmp = 65535
#map_size_udp = 131072
#map_size_gre = 65535
#map_size_psh = 131072
#map_size_socket = 65535
#map_size_handshake = 65535
#map_size_tcp_established = 200000
#map_size_geo_cache = 262144
#----------------------------------------------
*/