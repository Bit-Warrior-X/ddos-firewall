[Unit]
Description=A high performance web server and a reverse proxy server
#Documentation=man:nginx(8)
After=network.target nss-lookup.target

[Service]
Environment="PUBKEY_PATH=/usr/local/share/ebpf_firewall/server_public_key.pem"
Environment="LICENSE_PATH=/usr/local/share/ebpf_firewall/license.lic"

Type=forking
PIDFile=/var/run/l7_firewall.pid
ExecStartPre=/usr/local/openresty/nginx/sbin/nginx -t -q -g 'daemon on; master_process on;'
ExecStart=/usr/local/openresty/nginx/sbin/nginx -g 'daemon on; master_process on;'
ExecReload=/usr/local/openresty/nginx/sbin/nginx -g 'daemon on; master_process on;' -s reload
ExecStop=-/sbin/start-stop-daemon --quiet --stop --retry QUIT/5 --pidfile /var/run/l7_firewall.pid

TimeoutStopSec=5
KillMode=mixed

[Install]
WantedBy=multi-user.target