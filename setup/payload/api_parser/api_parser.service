#/home/usr/local/share/api_parser/venv/bin/python -m pip install --upgrade pip wheel setuptools
#/home/usr/local/share/api_parser/venv/bin/python -m pip install requests flask gunicorn

# /etc/systemd/system/api_parser.service
[Unit]
Description=api_parser (Gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=root
Group=root
WorkingDirectory=/usr/local/share/api_parser
Environment=PYTHONUNBUFFERED=1

# Create the FIFO if missing
#ExecStartPre=/usr/bin/test -p /tmp/firewall_to_api_parser.fifo || /usr/bin/mkfifo -m 666 /tmp/firewall_to_api_parser.fifo

# Use the venv's python to run gunicorn as a module
ExecStart=/usr/local/share/api_parser/venv/bin/python -m gunicorn \
          -w 2 -k gthread --threads 4 \
          -b 0.0.0.0:5000 \
          --timeout 60 --graceful-timeout 15 \
          app:app

Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGINT
Type=simple

[Install]
WantedBy=multi-user.target
