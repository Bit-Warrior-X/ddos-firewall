[Unit]
Description=eBPF Firewall Prometheus
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/usr/local/share/ebpf_firewall/
ExecStart=/usr/local/share/ebpf_firewall/ebpf_firewall_prom
Restart=on-failure
RestartSec=5
Environment="LD_LIBRARY_PATH=/usr/local/lib"

[Install]
WantedBy=multi-user.target
