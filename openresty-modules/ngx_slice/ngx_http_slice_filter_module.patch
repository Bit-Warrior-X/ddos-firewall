+char* ngx_http_slice_conf(ngx_conf_t* cf, ngx_command_t* cmd, void* conf) {
+    if (ngx_conf_set_flag_slot(cf, cmd, conf) != NGX_CONF_OK) {
+        return NGX_CONF_ERROR;
+    }
+
+    ngx_http_slice_loc_conf_t* loc_conf = conf;
+
+    ngx_shm_zone_t *shm_zone;
+    ngx_str_t *shm_name;
+
+    shm_name = ngx_palloc(cf->pool, sizeof *shm_name);
+    shm_name->len = sizeof("ngx_http_slice_filter_shared_memory") - 1;
+    shm_name->data = (unsigned char *) "ngx_http_slice_filter_shared_memory";
+    shm_zone = ngx_shared_memory_add(cf, shm_name, 8 * ngx_pagesize, &ngx_http_slice_filter_module);
+
+    if(shm_zone == NULL){
+        return NGX_CONF_ERROR;
+    }
+
+    shm_zone->init = ngx_http_slice_init_shm_zone;
+    shm_zone->data = loc_conf;
+    
+    loc_conf->shm_zone_slice_size = shm_zone;
+    
+    return NGX_CONF_OK;
+}
+
+static ngx_int_t 
+ngx_http_slice_init_shm_zone(ngx_shm_zone_t *shm_zone, void *data)
+{
+  ngx_slab_pool_t *shpool;
+  size_t * slice_size;
+  
+  ngx_http_slice_loc_conf_t* loc_conf = (ngx_http_slice_loc_conf_t*)(shm_zone->data);
+  shpool = (ngx_slab_pool_t *)shm_zone->shm.addr;
+  slice_size = ngx_slab_alloc(shpool, sizeof (*slice_size));
+  *slice_size = 0;
+  loc_conf->size = slice_size;
+  
+  return NGX_OK;
+}
 
