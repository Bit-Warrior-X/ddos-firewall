+    ngx_conf_merge_ptr_value(conf->shm_zone_slice_size, prev->shm_zone_slice_size, NGX_CONF_UNSET_PTR);
+    ngx_conf_merge_ptr_value(conf->size, prev->size, NGX_CONF_UNSET_PTR);
+    
     return NGX_CONF_OK;
 }
