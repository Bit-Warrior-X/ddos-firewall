ngx_addon_name=ngx_http_slice_module
CORE_INCS="$CORE_INCS $ngx_addon_dir"
HTTP_SLICE_SRCS="$ngx_addon_dir/ngx_http_slice_module.c"

if [ -n "$ngx_module_link" ]; then
    ngx_module_type=HTTP
    ngx_module_name="$ngx_addon_name"
    ngx_module_srcs="$HTTP_SLICE_SRCS"

    . auto/module
else
    HTTP_MODULES="$HTTP_MODULES $ngx_addon_name"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $HTTP_SLICE_SRCS"
fi

have=NGX_HTTP_SLICE_MODULE . auto/have