#==============================================================================
# firewall.redesign.config — target schema for the redesigned firewall
#
# 0.4.0 now ignores unknown keys (warn) and maps a safe subset
# (prefer_adaptive, enforce_drop_invalid, service_http3, …). Full schema is for
# the redesigned control loop. Sections follow the plan: detection, stage 0,
# validity, layers 1-4, lifecycle, Incident, mitigation, tier 0, upstream.
#
# Panel tier per key:  [T1] node owner   [T2] platform admin   [T3] installer/code
# auto  = detected or derived by the daemon and shown read-only in the panel.
# Lines stay under 120 characters (the current parser reads 128-byte lines).
#==============================================================================

#------------------GLOBAL--------------------------------
log = /var/firewall.log                         # [T3]
dev = bond0                                     # [T2] prefilled at install
attach_mode = auto                              # [T3] native if the driver supports XDP, else generic + warning
ipv6 = 1                                        # [T3]
vlan_parse = 1                                  # [T3] 802.1Q and QinQ

#------------------NIC DETECTION (re-read on every link change)------------
link_speed_mbps = auto                          # [T2] /sys/class/net/<dev>/speed; bond- and VLAN-aware
link_speed_fallback_mbps = 10000                # [T2] used when speed reads -1 (virtual NICs)
xdp_cores = auto                                # [T3] min(RX queues, cores on the NIC's NUMA node)
per_core_pps = 3000000                          # [T2] replace with the load-test result per profile
transit_capacity_bps = auto                     # [T2] auto = link speed; set the smallest upstream port
link_raise_delay_seconds = 60                   # [T3] ceilings drop at once, rise only after this

#------------------DESTINATIONS AND OWN SPACE-------------
# dst_prefixes: destinations with their own counters, baselines and Incident state.
# own_prefixes: your address space; outside packets claiming a source in it are dropped.
dst_prefixes = auto                             # [T2] auto = addresses on dev; overrides as CIDR list
own_prefixes = auto                             # [T2] auto = prefixes announced via BGP
own_prefix_whitelist_exempt = 1                 # [T3] whitelist is checked before the own-prefix drop

#------------------STAGE 0 (stateless, always on)--------
stage0_drop_invalid_flags = 1                   # [T3] NULL, XMAS, SYN+FIN, SYN+RST, SYN+URG, FIN-only
stage0_drop_tcp_fragments = 1                   # [T3]
stage0_drop_bogon_src = 1                       # [T3]
stage0_drop_land = 1                            # [T3]
stage0_drop_syn_payload = 1                     # [T3] SYN with data and no TFO cookie
stage0_check_lengths = 1                        # [T3] ihl, doff, tot_len vs frame (N4)
allowed_ip_protocols = tcp, udp, icmp, icmpv6   # [T1] via service profile; gre added when tunnels on
flag_anomaly_fin_threshold = 100                # [T2] former socket_fin_threshold, per source per window
flag_anomaly_fixed_threshold = 500              # [T2] former socket_fixed_threshold
flag_anomaly_window = 15                        # [T2] seconds

#------------------SERVICE PROFILE (drives validity allowlists)--------
service_http3 = 1                               # [T1] UDP 443 open, QUIC checks, higher UDP cap and floor
service_dns = 0                                 # [T1] UDP 53 open
service_gre_tunnels = 0                         # [T1] off = any GRE is an attack
gre_allowed_peers =                             # [T1] tunnel peers when service_gre_tunnels = 1

#------------------VALIDITY------------------------------
tcp_validity = socket_lookup                    # [T3] bpf_skc_lookup_tcp; conntrack mirror removed
syn_cookies = auto                              # [T3] xdp on kernel 6.0+, else kernel
synack_match_outbound = 1                       # [T3] TC egress records outbound SYNs (SYN-ACK class)
udp_extra_allowed_ports =                       # [T2] beyond those set by the service profile
udp_reflection_src_ports = 19, 53, 123, 161, 389, 1900, 3702, 11211   # [T3]
quic_header_check = 1                           # [T3] long-header version, Initial >= 1200 bytes
icmp_allowed_types = 0, 3, 8, 11                # [T2]
icmp_drop_fragments = 1                         # [T3]

#------------------LAYER 1: capacity ceilings------------
# host_ceiling_pps = ceiling_fraction x min(64-byte line rate, xdp_cores x per_core_pps)
# host_ceiling_bps = 0.8 x min(link speed, transit capacity)
host_ceiling_pps = auto                         # [T3]
host_ceiling_bps = auto                         # [T3]
ceiling_fraction = 0.65                         # [T3]
dst_ceiling_pps = 0                             # [T3] 0 = sum of class baselines x 3, capped by host
nic_drop_trigger_seconds = 3                    # [T3] sustained rx_missed / rx_no_buffer increase
softirq_trigger_percent = 80                    # [T3]
softirq_trigger_seconds = 3                     # [T3]
# Class caps = cap_fraction x host_ceiling_pps. Gates stay between floor and cap.
cap_fraction_syn = 0.02                         # [T3]
cap_fraction_ack = 0.05                         # [T3]
cap_fraction_rst = 0.01                         # [T3]
cap_fraction_icmp = 0.005                       # [T3]
cap_fraction_udp = 0.05                         # [T3] 0.15 while service_http3 = 1
cap_fraction_gre = 0.005                        # [T3] floor only while service_gre_tunnels = 0
cap_fraction_data = 0.10                        # [T3] DATA class (PSH+ACK and any payload)
floor_syn = 20000                               # [T3]
floor_ack = 50000                               # [T3]
floor_rst = 10000                               # [T3]
floor_icmp = 2000                               # [T3]
floor_udp = 20000                               # [T3] 50000 while service_http3 = 1
floor_gre = 1000                                # [T3]
floor_data = 50000                              # [T3]
stats_detail_sample_divisor = auto              # [T2] 1 up to 25G, 4 up to 100G, 8 above

#------------------LAYER 2: adaptive baseline------------
sample_interval_ms = 1000                       # [T3]
ewma_half_life_minutes = 45                     # [T3]
baseline_k = 6                                  # [T2] sigma multiplier
baseline_m = 3                                  # [T2] mean multiplier
baseline_seasonal = hour_of_week                # [T3] off | hour_of_week
baseline_growth_cap_per_hour = 2.0              # [T3]
learning_days = 7                               # [T3] gates start at cap / 4 until then
cusum = 1                                       # [T3]
# Owner sensitivity scales the gate, which is then clamped to floor and cap.
sensitivity_syn = normal                        # [T1] low (x2) | normal (x1) | high (x0.5)
sensitivity_ack = normal                        # [T1]
sensitivity_rst = normal                        # [T1]
sensitivity_icmp = normal                       # [T1]
sensitivity_udp = normal                        # [T1]
sensitivity_gre = normal                        # [T1]
sensitivity_data = normal                       # [T1] STOMP, HANDSHAKE and SOCKET

#------------------LAYER 3: invalid traffic--------------
invalid_floor_pps = 1000                        # [T3]
invalid_ratio = 0.05                            # [T3] invalid / total for the class

#------------------LAYER 4: established flows------------
data_class_by_payload = 1                       # [T3] payload > 0 is DATA; PSH bit ignored (C3)
flows_map_size = auto                           # [T3] LRU_PERCPU_HASH, 4-tuple key, sized from RAM
flow_pps_k = 6                                  # [T2] STOMP: per-flow data rate vs destination baseline
source_new_flows_k = 6                          # [T2] HANDSHAKE: new flows per second per source
psh_len_window = 32                             # [T3] length-profile label, re-evaluated each window
psh_len_differ_handshake = 5                    # [T3]
label_priority = flow_shape                     # [T3] flow shape wins over payload length (N3)
labels_independent = 1                          # [T3] STOMP and HANDSHAKE can both be active (N2)
source_concurrent_cap = 1000                    # [T1] SOCKET, per source, Attack only (min 200)
prefix24_concurrent_cap = 20000                 # [T2] SOCKET, per /24, Attack only
idle_reap_seconds = 60                          # [T2] SOCKET: idle connections with no payload

#------------------LIFECYCLE (per destination and class)--------
confirm_windows = 3                             # [T3] N
exit_windows = 45                               # [T3] M, seconds below T_exit
t_exit_mean_multiplier = 1.5                    # [T3]
t_exit_enter_fraction = 0.5                     # [T3]
cooldown_seconds = 90                           # [T2]

#------------------INCIDENT (per destination and per prefix)----
incident_confirm_windows = 1                    # [T3]
incident_k = 4                                  # [T3]
incident_m = 2                                  # [T3]
incident_drop_invalid_all_classes = 1           # [T3]
recovery_seconds = 120                          # [T2]
vector_listing_share = 0.05                     # [T3] class listed in the incident record

#------------------MITIGATION----------------------------
escalate_after_windows = 5                      # [T3]
blacklist_spoofable_classes = 0                 # [T3] blacklist only proven sources
block_initial_seconds = 60                      # [T1] doubles per repeat offence (panel range 60-600)
block_max_seconds = 3600                        # [T1] panel range 300-7200
src_bucket_k = 3                                # [T2] per-source bucket = 3x source baseline

#------------------TIER 0: NIC hardware------------------
hw_backend = auto                               # [T2] mlx5_core: tc_flower; Intel: ntuple; BlueField-3: doca_flow
hw_max_rules = auto                             # [T2] per NIC model and firmware
hw_rule_from_vector_mix = 1                     # [T3]
hw_per_ip_rules_for_spoofable = 0               # [T3]

#------------------UPSTREAM ESCALATION (admin only)------
upstream_trigger_percent = 80                   # [T2] of min(link, transit)
upstream_trigger_seconds = 10                   # [T2]
flowspec = 0                                    # [T2] needs upstream support
scrubbing = 0                                   # [T2]
rtbh_last_resort = 0                            # [T2]
bgp_speaker = gobgp                             # [T3]

#------------------GEO (unchanged)-----------------------
geo_check = 2                                   # [T1]
geo_db_ipv4_path = geodb/ipv4.csv               # [T3]
geo_db_location_path = geodb/location.csv       # [T3]
geo_countries = CN,RU,IN,PH,VN,BR               # [T1]
