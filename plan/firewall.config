#==============================================================================
# firewall.config for ebpf_firewall 0.4.0 — Phase 0 template (Dorian panel)
#
# Unknown keys are ignored with a warning (redesign.config subset is accepted).
# The panel writes this whole file per node.
#
# Keys marked [DERIVED] are computed per node by the panel (plan section
# "Hardware: NIC speed and derived parameters"):
#   line_pps          = link_bps / ((64 + 20) * 8)
#   cpu_pps           = min(rx_queues, cores on the NIC's NUMA node) * per_core_pps
#   host_ceiling_pps  = 0.65 * min(line_pps, cpu_pps)
#   cap               = cap_fraction * host_ceiling_pps
#   gate              = clamp(3 * weekly_p99, floor, cap)    (first 7 days: cap / 4)
#
#   class        cap_fraction            floor
#   SYN          2%                      20,000
#   ACK          5%                      50,000
#   RST          1%                      10,000
#   ICMP         0.5%                    2,000
#   UDP          5% (15% with HTTP/3)    20,000 (50,000 with HTTP/3)
#   GRE          0.5% with tunnels       1,000 (floor only without tunnels)
#   PSH+ACK      10%                     50,000   -> stomp_threshold = handshake_threshold
#
# The [DERIVED] values written below are for the fallback profile used when
# nothing is known yet: 10 Gb/s, 8 cores, 3 Mpps per core, new node, HTTP/3 on,
# no GRE tunnels. Start gates for other speeds (8/16/32/64 cores):
#
#   key                  10G        25G        100G       200G
#   syn_threshold        48000      121000     312000     624000
#   ack_threshold        121000     302000     780000     1560000
#   rst_threshold        24000      60000      156000     312000
#   icmp_threshold       12000      30000      78000      156000
#   udp_threshold        363000     907000     2340000    4680000
#   stomp/handshake      242000     605000     1560000    3120000
#   stats_detail_sample_divisor 1   1          4          8
#
# Per-source limits, durations and the connection cap are NOT derived from NIC
# speed: they describe client behavior (CGNAT, HTTP/3), not host capacity.
#
# Pair with kernel/99-ddos-firewall.conf:
#   net.netfilter.nf_conntrack_tcp_loose = 0      (finding C4)
#==============================================================================

#------------------GLOBAL-------------------
log = /var/firewall.log
# Detected at install (scripts/set-firewall-dev.sh); admin can change in the panel.
dev = bond0
# native when the driver supports XDP (mlx5_core, ice, i40e, ixgbe, virtio_net, ena).
attach_mode = native
# Most 0.4.0 blocks come from spoofable packets (H1); 10 minutes limits the
# damage when an attacker spoofs real users. Panel range: 300-7200.
black_ip_duration = 600

#------------------SYN-----------------------
syn_valid = 1
syn_threshold = 48000                 # [DERIVED]
# Burst keys have no effect in 0.4.0 (finding N5: gap = 1 s / count, so the
# detector cannot fire). Fixed values; count must not be 0.
syn_burst_pkt = 50
syn_burst_count_per_sec = 5
# Per source, attack mode only: 300 SYNs in 3 s. Covers CGNAT and proxies.
syn_fixed_threshold = 300
syn_fixed_check_duration = 3
challenge_timeout = 3
syn_protection_duration = 120

#------------------ACK-----------------------
ack_valid = 1
ack_threshold = 121000                # [DERIVED]
ack_burst_pkt = 300
ack_burst_count_per_sec = 50
ack_fixed_threshold = 5000
ack_fixed_check_duration = 15
ack_protection_duration = 120

#------------------RST-----------------------
rst_valid = 1
rst_threshold = 24000                 # [DERIVED]
rst_burst_pkt = 10
rst_burst_count_per_sec = 5
# 50/s per source in attack mode. RSTs are spoofable; low limits block the
# addresses an attacker chooses to spoof.
rst_fixed_threshold = 500
rst_fixed_check_duration = 10
rst_protection_duration = 120

#------------------ICMP-----------------------
icmp_valid = 1
icmp_threshold = 12000                # [DERIVED]
icmp_burst_pkt = 10
icmp_burst_count_per_sec = 5
# 20/s per source in attack mode, so monitoring and PMTU traffic pass.
icmp_fixed_threshold = 200
icmp_fixed_check_duration = 10
icmp_protection_duration = 120

#------------------UDP------------------------
udp_valid = 1
udp_threshold = 363000                # [DERIVED] HTTP/3 on (15% cap); off: 5% cap
udp_burst_pkt = 50
udp_burst_count_per_sec = 10
# 3,000/s per source in attack mode. An HTTP/3 client downloading at 50 Mb/s
# sends about 2,000 packets/s. Panel floor while HTTP/3 is on: 30000.
# Without any UDP service: 500.
udp_fixed_threshold = 30000
udp_fixed_check_duration = 10
udp_protection_duration = 120

#------------------GRE------------------------
gre_valid = 1
# No tunnels on this node: any GRE is an attack, so the gate sits at the floor.
gre_threshold = 1000                  # [DERIVED]
gre_burst_pkt = 10
gre_burst_count_per_sec = 5
gre_fixed_threshold = 50
gre_fixed_check_duration = 10
gre_protection_duration = 120
#----------------------------------------------

#-----------------TCP Segment check------------
tcp_seg_check = 1
# Detailed stats sampling; detection counters are not sampled.
stats_detail_sample_divisor = 1       # [DERIVED] 1 up to 25G, 4 up to 100G, 8 above
#----------------------------------------------

#-----------------Geo Location Check ----------
geo_check = 2
geo_db_ipv4_path = geodb/ipv4.csv
geo_db_location_path = geodb/location.csv
geo_countries = CN,RU,IN,PH,VN,BR
#----------------------------------------------

#-----------------TCP Connection Limit ---------
tcp_connection_limit_check = 1
# Concurrent connections per source IP. One CGNAT address can carry hundreds
# of mobile users. Panel minimum: 200.
tcp_connection_limit_cnt = 1000
#----------------------------------------------

#------------------STOMP------------------------
stomp_valid = 1
# PSH+ACK gate (finding N1): 0.4.0 compares host-wide PSH+ACK with
# min(stomp_threshold, handshake_threshold), and that counter includes all
# legitimate client data. The panel edits both as one field.
stomp_threshold = 242000              # [DERIVED]
stomp_burst_pkt = 50
stomp_burst_count_per_sec = 10
# Per source once protection is on, established clients included: 500/s.
stomp_fixed_threshold = 5000
stomp_fixed_check_duration = 10
stomp_protection_duration = 120
#----------------------------------------------

#------------------HandShake--------------------
handshake_valid = 1
# Same value as stomp_threshold. Trade-off (H7): this key also starts
# protection for SYN+ACK floods, which in 0.4.0 share the HANDSHAKE counter;
# SYN+ACK floods below the gate are left to the kernel, which drops unmatched
# SYN-ACKs.
handshake_threshold = 242000          # [DERIVED]
handshake_burst_pkt = 50
handshake_burst_count_per_sec = 10
handshake_fixed_threshold = 5000
handshake_fixed_check_duration = 10
handshake_protection_duration = 120
#----------------------------------------------

#------------------SOCKET------------------------
# Unusual TCP flags only. NULL and XMAS are always dropped.
socket_valid = 1
socket_fin_threshold = 100
socket_fixed_threshold = 500
socket_fixed_check_duration = 15
#----------------------------------------------

#-----------------Map Sizing--------------------
#map_size_blocked_ips = 65535
#map_size_syn = 131072
#map_size_ack = 131072
#map_size_rst = 131072
#map_size_icmp = 65535
#map_size_udp = 131072
#map_size_gre = 65535
#map_size_psh = 131072
#map_size_socket = 65535
#map_size_handshake = 65535
#map_size_tcp_established = 200000
#map_size_geo_cache = 262144
#----------------------------------------------
